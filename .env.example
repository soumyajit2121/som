# Copy to .env.local for local development. Placeholder values only.

# --- Supabase (Project Settings → API) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon (or publishable) key. Safe for the browser: RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role (or secret) key. SERVER ONLY — never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application ------------------------------------------------------------
# Public base URL, used in auth email links (https://your-app.vercel.app in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# --- Web Push (VAPID). Generate with: npx web-push generate-vapid-keys ------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# SERVER ONLY. Never commit the real value.
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact for push services: mailto: address or https URL.
VAPID_SUBJECT=mailto:admin@example.com
